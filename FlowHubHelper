   Name = "Safe Water Walk",
   CurrentValue = false,
   Callback = function(v)
       WaterBypass = v
       task.spawn(function()
           while WaterBypass do
               local char = game.Players.LocalPlayer.Character
               if char and char:FindFirstChild("HumanoidRootPart") then
                   local pos = char.HumanoidRootPart.Position
                   -- Cek jika berada di level air
                   if pos.Y < 4 then -- Sesuaikan dengan ketinggian air di Fish It
                       char.HumanoidRootPart.Velocity = Vector3.new(char.HumanoidRootPart.Velocity.X, 0, char.HumanoidRootPart.Velocity.Z)
                       char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 0.05, 0)
                   end
               end
               task.wait()
           end
       end)
   end,
})

